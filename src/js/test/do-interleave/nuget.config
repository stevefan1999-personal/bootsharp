<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <!-- The Bootsharp under test is the one ./src/cs/.scripts/pack.sh builds from this working
             tree. Source mapping decides by identity rather than by whichever source answers
             first, so a same-named package from nuget.org can never win here. -->
        <add key="bootsharp" value="../../../cs/.nuget"/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="bootsharp">
            <package pattern="Bootsharp*"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
