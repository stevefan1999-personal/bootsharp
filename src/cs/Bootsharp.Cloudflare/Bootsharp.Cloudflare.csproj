<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyTitle>Bootsharp.Cloudflare</AssemblyTitle>
        <PackageId>Bootsharp.Cloudflare</PackageId>
        <Description>Run Bootsharp apps on Cloudflare Workers: workerd bindings, entrypoint bases and structured logging.</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- NU5100: the task assemblies live under tasks/, not lib/, exactly as in Bootsharp. -->
        <NoWarn>CS1591;NU5100</NoWarn>
        <!-- Consumers publish with NativeAOT-LLVM, so the trim and AOT analyzers have to run here
             rather than surface as warnings inside the app that references this package. -->
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The analyzer ships inside this package rather than as one of its own, mirroring how
             Bootsharp.Generate ships inside Bootsharp.Common: one analyzer assembly for the whole
             family, so subsystem generators can never collide as duplicate types (ADR-0007). -->
        <None Include="../Bootsharp.Cloudflare.Generate/bin/$(Configuration)/netstandard2.0/Bootsharp.Cloudflare.Generate.dll"
              Pack="true" Visible="false" PackagePath="analyzers/dotnet/cs"/>
        <!-- Targets driving the publish-time worker emission, and the ESM assets it places next to
             the emitted module. Laid out as Bootsharp lays out its own build/, js/ and tasks/. -->
        <Content Include="Build/**" Pack="true" PackagePath="build/"/>
        <Content Include="js/**" Pack="true" PackagePath="js/"/>
    </ItemGroup>

    <!-- Packs the MSBuild task and its dependencies, mirroring Bootsharp's PackPublisher. -->
    <Target Name="PackWorkerEmitter" BeforeTargets="CoreCompile">
        <MSBuild Projects="../Bootsharp.Cloudflare.Publish/Bootsharp.Cloudflare.Publish.csproj"
                 Targets="Restore;Publish;PublishItemsOutputGroup">
            <Output TaskParameter="TargetOutputs" ItemName="_WorkerEmitterOutputs"/>
        </MSBuild>
        <ItemGroup>
            <Content Include="@(_WorkerEmitterOutputs)"
                     Condition="'%(_WorkerEmitterOutputs.Extension)' == '.dll'"
                     Pack="true"
                     PackagePath="tasks/%(_WorkerEmitterOutputs.TargetPath)"
                     KeepMetadata="Pack;PackagePath"/>
        </ItemGroup>
    </Target>

</Project>
