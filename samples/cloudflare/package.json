{
  "name": "bootsharp-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "publish:cs": "dotnet publish backend/Cloudflare.Backend.csproj -c Release /p:BsLlvm=true /p:MSBuildEnableWorkloadResolver=false",
    "publish:frontend": "node scripts/prepare-assets.mjs",
    "dev": "npm run publish:cs && npm run publish:frontend && wrangler dev",
    "deploy": "npm run publish:cs && npm run publish:frontend && wrangler deploy",
    "types": "wrangler types",
    "check:ts": "npm run types && tsc --noEmit -p tsconfig.json",
    "test:generator": "dotnet test generator.tests/Bootsharp.Cloudflare.Generate.Tests.csproj /p:MSBuildEnableWorkloadResolver=false"
  },
  "devDependencies": {
    "wrangler": "^4.122.0",
    "@cloudflare/workers-types": "^5.20260813.1",
    "typescript": "^5.9.3"
  }
}
