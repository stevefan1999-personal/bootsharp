<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>Microsoft.Data.Sqlite</AssemblyName>
        <RootNamespace>Microsoft.Data.Sqlite</RootNamespace>
        <AssemblyVersion>6.0.0.0</AssemblyVersion>
        <FileVersion>6.0.0.0</FileVersion>
        <Version>6.0.0</Version>
        <Description>Metadata stub so linq2db's SQLite Microsoft adapter can load without SQLitePCLRaw.</Description>
        <IsAotCompatible>true</IsAotCompatible>
        <!-- This is not a Worker; skip Bootsharp/emscripten from Directory.Build.props. -->
        <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    </PropertyGroup>
</Project>
