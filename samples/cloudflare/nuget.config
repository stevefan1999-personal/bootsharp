<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- The bootsharp packages this sample consumes are the ones ./src/cs/.scripts/pack.sh
             produces from this working tree, not the 0.9.0 published to nuget.org: milestone 0a/0b
             (ADR-0007) change Bootsharp.Publish and the emitter, and neither is observable here
             unless the sample restores the local pack. -->
        <add key="bootsharp" value="../../src/cs/.nuget" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
    <!-- The local pack carries the SAME version string as the published package (0.9.0, from
         src/cs/Directory.Build.props), so "highest version wins" cannot separate them and a
         restore would silently take whichever source answered first — or the globally cached
         nuget.org copy. Source mapping makes the choice by identity instead of by race. -->
    <packageSourceMapping>
        <packageSource key="bootsharp">
            <package pattern="Bootsharp*" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
