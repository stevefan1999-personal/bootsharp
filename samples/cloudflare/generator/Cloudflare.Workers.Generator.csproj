<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS1035: the generator writes the emitted ESM into the source tree until ADR-0006 §1
         moves that write into the publish pipeline. -->
    <NoWarn>$(NoWarn);RS1035</NoWarn>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cloudflare.Workers.Generator</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
