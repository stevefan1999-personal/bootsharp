{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bootsharp-cloudflare",
  // A hand-written module that re-exports the emitted one (`dist/worker/entrypoints.ts`, written by
  // `dotnet publish`) and adds the two things a SignalR hub needs and the emitter cannot produce:
  // workerd's reserved hibernation callbacks, and a 101 response carrying a live socket. See its
  // header. A worker with no hub points `main` straight at the emitted module.
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-13",
  // Required by Bootsharp.Cloudflare, not optional: js/runtime.mjs imports AsyncLocalStorage
  // from node:async_hooks to scope handles per logical invocation. nodejs_als
  // alone is enough for that import; nodejs_compat is the superset and what.NET wants anyway.
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "bb69253f02c5edc7125c285387b47388",
  "workers_dev": true,
  "preview_urls": true,
  "limits": { "cpu_ms": 30000 },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "assets": {
    "directory": "./dist/wwwroot",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "KV", "id": "3263afc8eb894d0191b47caeb62cdc2d" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bootsharp-cf",
      "database_id": "51e0c7c3-c2e7-4e3b-af8a-48121454e2d0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "bootsharp-cf" }
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "bootsharp-cf" }],
    "consumers": [
      {
        "queue": "bootsharp-cf",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      // The hub's room. `class_name` is the wrapper exported by worker/index.ts, not the emitted
      // ChatRoom it subclasses — the wrapper is what carries the hibernation callbacks.
      { "name": "CHAT", "class_name": "ChatRoomHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter"] },
    { "tag": "v2", "new_sqlite_classes": ["ChatRoomHub"] }
  ],
  "workflows": [
    {
      "binding": "WORKFLOW",
      "name": "bootsharp-demo",
      "class_name": "DemoWorkflow"
    }
  ]
}
