{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bootsharp-cloudflare-minimal",
  // Emitted by `dotnet publish` (the Bootsharp.Cloudflare publish task), next to the wasm binary
  // and the Bootsharp ES modules it imports. `npm run dev` and `npm run deploy` publish first.
  "main": "dist/worker/entrypoints.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  // No account_id on purpose: `wrangler dev --local` needs none, and `wrangler deploy` takes the
  // account from `wrangler login`. Add yours only if your credentials reach more than one account.
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // workerd refuses to compile wasm from bytes inside a request, so the binary reaches the isolate
  // as a module import instead — this rule is what makes `import wasmModule from "*.wasm"` legal.
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "kv_namespaces": [
    // Placeholder id. `wrangler dev --local` simulates KV and never reads it; before deploying,
    // run `wrangler kv namespace create KV` and paste the id it prints over these zeroes.
    { "binding": "KV", "id": "00000000000000000000000000000000" }
  ]
}
