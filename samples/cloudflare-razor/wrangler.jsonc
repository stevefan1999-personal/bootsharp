{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bootsharp-cloudflare-razor",
  // Emitted by `dotnet publish` (the Bootsharp.Cloudflare publish task). `npm run deploy` publishes first.
  "main": "dist/worker/entrypoints.ts",
  "compatibility_date": "2026-08-14",
  // Required by Bootsharp.Cloudflare: js/runtime.mjs imports AsyncLocalStorage from node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bootsharp-cf-razor",
      "database_id": "d6c4e606-1ade-4aac-9ebc-16eb203ca00e",
      "migrations_dir": "migrations"
    }
  ]
}
